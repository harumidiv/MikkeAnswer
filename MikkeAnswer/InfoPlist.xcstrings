    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La càmera s’utilitza per fotografiar jocs de buscar les diferències."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoaparát se používá k focení hádanek „Najdi rozdíly“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameraet bruges til at fotografere find fem fejl-opgaver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera wird verwendet, um Suchbilder zu fotografieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κάμερα χρησιμοποιείται για τη λήψη φωτογραφιών παζλ «Βρες τις διαφορές»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is used to take photos of spot-the-difference puzzles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cámara se usa para fotografiar pasatiempos de buscar las diferencias."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameraa käytetään etsi erot -tehtävien kuvaamiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil photo sert à photographier les jeux des différences."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अंतर खोजने वाली पहेलियों की फ़ोटो लेने के लिए कैमरा का उपयोग किया जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera se koristi za snimanje zagonetki „Pronađi razlike”."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kamera a különbségkereső feladványok lefotózására szolgál."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera digunakan untuk memotret teka-teki mencari perbedaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fotocamera viene usata per fotografare i giochi “trova le differenze”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "間違い探しの絵を撮影するためにカメラを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "틀린 그림 찾기 사진을 촬영하는 데 카메라를 사용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera digunakan untuk mengambil foto teka-teki cari perbezaan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameraet brukes til å ta bilder av finn fem feil-oppgaver."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De camera wordt gebruikt om zoek-de-verschillenpuzzels te fotograferen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparat służy do fotografowania łamigłówek „Znajdź różnice”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A câmera é usada para fotografar jogos de sete erros."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A câmara é utilizada para fotografar jogos de descobrir as diferenças."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera este folosită pentru a fotografia jocurile de găsit diferențe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камера используется для съёмки головоломок «Найди отличия»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoaparát sa používa na fotenie hádaniek „Nájdi rozdiely“."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameran används för att fotografera hitta fem fel-pussel."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้กล้องเพื่อถ่ายภาพเกมจับผิดภาพ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera, fark bulma bulmacalarının fotoğrafını çekmek için kullanılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камера використовується для зйомки головоломок «Знайди відмінності»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera được dùng để chụp ảnh trò tìm điểm khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于拍摄找不同游戏的照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於拍攝大家來找碴的照片。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les imatges amb les respostes dels jocs de buscar les diferències es desen a Fotos."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrázky s odpověďmi se ukládají do Fotek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svarbilleder til find fem fejl-opgaver gemmes i Fotos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lösungsbilder von Suchbildern werden in „Fotos“ gesichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι εικόνες με τις απαντήσεις αποθηκεύονται στις Φωτογραφίες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Answer images of spot-the-difference puzzles are saved to Photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las imágenes con las respuestas de buscar las diferencias se guardan en Fotos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etsi erot -tehtävien vastauskuvat tallennetaan Kuviin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les images des réponses aux jeux des différences sont enregistrées dans Photos."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अंतर खोजने वाली पहेलियों की उत्तर इमेज तस्वीरें में सहेजी जाती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slike s odgovorima spremaju se u Fotografije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A különbségkereső feladványok válaszképei a Fotókba kerülnek mentésre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gambar jawaban teka-teki mencari perbedaan disimpan ke Foto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le immagini con le soluzioni dei giochi “trova le differenze” vengono salvate in Foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "間違い探しの答えの画像を写真に保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "틀린 그림 찾기의 정답 이미지를 사진에 저장합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imej jawapan teka-teki cari perbezaan disimpan ke Foto."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svarbilder for finn fem feil-oppgaver lagres i Bilder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antwoordafbeeldingen van zoek-de-verschillenpuzzels worden bewaard in Foto’s."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrazy z odpowiedziami są zapisywane w Zdjęciach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As imagens com as respostas dos jogos de sete erros são salvas em Fotos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As imagens com as respostas dos jogos de descobrir as diferenças são guardadas em Fotografias."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imaginile cu răspunsurile jocurilor de găsit diferențe sunt salvate în Poze."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изображения с ответами сохраняются в «Фото»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrázky s odpoveďami sa ukladajú do Fotiek."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svarsbilder för hitta fem fel-pussel sparas i Bilder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกภาพเฉลยของเกมจับผิดภาพลงในรูปภาพ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fark bulma bulmacalarının cevap görüntüleri Fotoğraflar'a kaydedilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зображення з відповідями зберігаються у «Фото»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ảnh đáp án của trò tìm điểm khác sẽ được lưu vào Ảnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于将找不同的答案图像存储到“照片”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於將大家來找碴的答案影像儲存至「照片」。"
          }
        }
      }
    },
    "NSUserTrackingUsageDescription" : {
      "comment" : "Privacy - Tracking Usage Description",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ho permets, és més probable que vegis anuncis adequats per a tu. Les teves fotos i els resultats de l’anàlisi no s’envien mai."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud to povolíte, uvidíte spíše reklamy, které vám vyhovují. Vaše fotky a výsledky analýzy se nikam neodesílají."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du tillader det, er det mere sandsynligt, at du ser reklamer, der passer til dig. Dine fotos og analyseresultater sendes aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du dies erlaubst, siehst du eher Werbung, die zu dir passt. Deine Fotos und Analyseergebnisse werden nie gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν το επιτρέψετε, είναι πιο πιθανό να βλέπετε διαφημίσεις που σας ταιριάζουν. Οι φωτογραφίες σας και τα αποτελέσματα της ανάλυσης δεν αποστέλλονται ποτέ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you allow this, you're more likely to see ads that suit you. Your photos and analysis results are never sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si lo permites, es más probable que veas anuncios adecuados para ti. Tus fotos y resultados de análisis nunca se envían."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos sallit tämän, näet todennäköisemmin sinulle sopivia mainoksia. Kuviasi tai analyysin tuloksia ei koskaan lähetetä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous l’autorisez, vous verrez plus probablement des publicités adaptées à vos goûts. Vos photos et résultats d’analyse ne sont jamais envoyés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुमति देने पर आपको अपने लिए उपयुक्त विज्ञापन दिखने की संभावना बढ़ जाती है। आपकी फ़ोटो और विश्लेषण के परिणाम कभी नहीं भेजे जाते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako to dopustite, vjerojatnije ćete vidjeti oglase koji vam odgovaraju. Vaše fotografije i rezultati analize nikada se ne šalju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha engedélyezi, nagyobb eséllyel lát Önnek megfelelő hirdetéseket. A fotóit és az elemzés eredményeit soha nem küldjük el."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika Anda mengizinkan, Anda akan lebih mungkin melihat iklan yang sesuai untuk Anda. Foto dan hasil analisis Anda tidak pernah dikirim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se lo consenti, è più probabile che tu veda pubblicità adatte a te. Le tue foto e i risultati delle analisi non vengono mai inviati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可すると、あなたに合った広告が表示されやすくなります。写真や解析の内容は送信しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "허용하면 사용자에게 맞는 광고가 표시될 가능성이 높아집니다. 사진이나 분석 결과는 전송되지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika anda membenarkannya, anda lebih berkemungkinan melihat iklan yang sesuai dengan anda. Foto dan hasil analisis anda tidak akan dihantar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du tillater dette, er det mer sannsynlig at du ser annonser som passer deg. Bildene og analyseresultatene dine sendes aldri."
