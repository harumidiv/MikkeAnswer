{
  "sourceLanguage": "ja",
  "strings": {
    "2 つの絵が両方写るように撮影してください": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegura’t que les dues imatges surtin a la foto"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na fotce musí být oba obrázky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sørg for, at begge billeder er med på fotoet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achte darauf, dass beide Bilder auf dem Foto sind"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βεβαιωθείτε ότι φαίνονται και οι δύο εικόνες"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure both pictures are in the photo"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que salgan las dos imágenes en la foto"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmista, että molemmat kuvat näkyvät"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assurez-vous que les deux images figurent sur la photo"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुनिश्चित करें कि दोनों चित्र फ़ोटो में हों"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obje slike moraju biti na fotografiji"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindkét kép legyen rajta a fotón"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan kedua gambar ada di dalam foto"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assicurati che nella foto ci siano entrambe le immagini"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 그림이 모두 나오도록 촬영하십시오"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan kedua-dua gambar ada dalam foto"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sørg for at begge bildene er med"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorg dat beide afbeeldingen op de foto staan"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oba obrazki muszą być widoczne na zdjęciu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se as duas imagens aparecem na foto"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifique-se de que as duas imagens aparecem na fotografia"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigurați-vă că ambele imagini apar în poză"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обе картинки должны попасть в кадр"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na fotke musia byť oba obrázky"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se till att båda bilderna kommer med"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดถ่ายให้เห็นภาพทั้งสองภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki resmin de fotoğrafta olduğundan emin olun"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обидві картинки мають потрапити в кадр"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chụp sao cho cả hai hình đều có trong ảnh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确保两张图都在照片中"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認兩張圖都在照片中"
          }
        }
      }
    },
    "2 つの絵の重なりが小さすぎます。「範囲・重ね方を調整」から重ね直してください。": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dues imatges se superposen massa poc. Torna-les a superposar des de «Àrees i superposició»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrázky se překrývají příliš málo. Překryjte je znovu v „Oblasti a překrytí“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De to billeder overlapper for lidt. Læg dem oven på hinanden igen via “Juster områder og overlejring”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die beiden Bilder überlappen zu wenig. Überlagere sie erneut unter „Bereiche & Überlagerung“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι δύο εικόνες επικαλύπτονται πολύ λίγο. Επικαλύψτε τις ξανά από το «Περιοχές και επικάλυψη»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The two pictures overlap too little. Overlay them again from \"Adjust Areas & Overlay\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las dos imágenes se solapan demasiado poco. Vuelve a superponerlas desde “Áreas y superposición”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvat ovat liian vähän päällekkäin. Aseta ne uudelleen päällekkäin kohdasta ”Säädä alueet ja päällekkäisyys”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux images ne se chevauchent pas assez. Superposez-les à nouveau depuis « Zones et superposition »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोनों चित्र बहुत कम ओवरलैप हो रहे हैं। \"क्षेत्र और ओवरले समायोजित करें\" से फिर से ओवरले करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slike se premalo preklapaju. Ponovno ih preklopite u „Područja i preklapanje”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A két kép túl kevéssé fedi egymást. Illessze őket újra a „Területek és illesztés” gombbal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedua gambar terlalu sedikit bertumpuk. Tumpuk ulang dari \"Sesuaikan Area & Tumpukan\"."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le due immagini si sovrappongono troppo poco. Sovrapponile di nuovo da “Aree e sovrapposizione”."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 그림이 겹치는 부분이 너무 작습니다. '범위 및 겹치기 조절'에서 다시 겹치십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedua-dua gambar terlalu sedikit bertindih. Tindih semula daripada \"Laraskan Kawasan & Tindihan\"."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De to bildene overlapper for lite. Legg dem over hverandre på nytt via «Juster områder og overlegg»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De twee afbeeldingen overlappen te weinig. Leg ze opnieuw over elkaar via ‘Gebieden en overlay’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrazki nakładają się zbyt mało. Nałóż je ponownie w „Obszary i nałożenie”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As duas imagens se sobrepõem muito pouco. Sobreponha-as novamente em “Áreas e Sobreposição”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As duas imagens sobrepõem-se muito pouco. Volte a sobrepô-las em “Áreas e sobreposição”."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cele două imagini se suprapun prea puțin. Suprapuneți-le din nou din „Zone și suprapunere”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Картинки перекрываются слишком мало. Совместите их заново через «Области и наложение»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrázky sa prekrývajú príliš málo. Prekryte ich znova v „Oblasti a prekrytie“."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De två bilderna överlappar för lite. Lägg dem över varandra igen via ”Justera områden och överlägg”."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพทั้งสองซ้อนกันน้อยเกินไป โปรดซ้อนใหม่จาก \"ปรับขอบเขตและการซ้อนภาพ\""
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki resim çok az örtüşüyor. “Alanları ve Hizalamayı Ayarla” bölümünden yeniden üst üste koyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картинки перекриваються замало. Сумістіть їх знову через «Області й накладання»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai hình chồng lên nhau quá ít. Hãy chồng lại từ \"Chỉnh vùng và chồng hình\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两张图的重合部分太少。请通过“调整范围与叠加”重新叠加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩張圖的重疊部分太少。請透過「調整範圍與疊合」重新疊合。"
          }
        }
      }
    },
    "2 つの絵を見つけられませんでした。2 枚の絵全体が写るように撮影するか、「範囲・重ね方を調整」で絵の範囲を指定してください。": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’han trobat les dues imatges. Fes una foto on es vegin senceres o defineix les àrees amb «Àrees i superposició»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dva obrázky nebyly nalezeny. Vyfoťte oba obrázky celé, nebo nastavte oblasti v „Oblasti a překrytí“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De to billeder blev ikke fundet. Tag et foto, hvor begge billeder ses helt, eller angiv billedområderne med “Juster områder og overlejring”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die beiden Bilder wurden nicht gefunden. Nimm ein Foto auf, auf dem beide Bilder vollständig zu sehen sind, oder lege die Bereiche unter „Bereiche & Überlagerung“ fest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκαν οι δύο εικόνες. Τραβήξτε μια φωτογραφία όπου φαίνονται ολόκληρες και οι δύο εικόνες ή ορίστε τις περιοχές από το «Περιοχές και επικάλυψη»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't find the two pictures. Take a photo that shows both pictures entirely, or set the picture areas with \"Adjust Areas & Overlay\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron las dos imágenes. Haz una foto en la que se vean completas, o define las áreas con “Áreas y superposición”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kahta kuvaa ei löytynyt. Ota kuva, jossa molemmat kuvat näkyvät kokonaan, tai määritä kuva-alueet kohdasta ”Säädä alueet ja päällekkäisyys”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de trouver les deux images. Prenez une photo où les deux images sont entièrement visibles, ou définissez les zones avec « Zones et superposition »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोनों चित्र नहीं मिले। ऐसी फ़ोटो लें जिसमें दोनों चित्र पूरे दिखें, या \"क्षेत्र और ओवरले समायोजित करें\" से चित्र क्षेत्र सेट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvije slike nisu pronađene. Snimite fotografiju na kojoj su obje slike cijele ili postavite područja u „Područja i preklapanje”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem található a két kép. Készítsen olyan fotót, amelyen mindkét kép teljesen látszik, vagy adja meg a képterületeket a „Területek és illesztés” gombbal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menemukan kedua gambar. Ambil foto yang menampilkan kedua gambar secara utuh, atau tentukan area gambar dengan \"Sesuaikan Area & Tumpukan\"."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile trovare le due immagini. Scatta una foto in cui siano entrambe interamente visibili, oppure imposta le aree con “Aree e sovrapposizione”."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 그림을 찾지 못했습니다. 두 그림 전체가 나오도록 촬영하거나 '범위 및 겹치기 조절'에서 그림 범위를 지정하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menemui kedua-dua gambar. Ambil foto yang menunjukkan kedua-dua gambar sepenuhnya, atau tetapkan kawasan gambar dengan \"Laraskan Kawasan & Tindihan\"."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ikke de to bildene. Ta et bilde der begge bildene vises helt, eller angi bildeområdene med «Juster områder og overlegg»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de twee afbeeldingen niet vinden. Maak een foto waarop beide afbeeldingen volledig te zien zijn, of stel de gebieden in via ‘Gebieden en overlay’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono dwóch obrazków. Zrób zdjęcie, na którym widać oba obrazki w całości, lub ustaw obszary w „Obszary i nałożenie”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível encontrar as duas imagens. Tire uma foto em que as duas apareçam inteiras ou defina as áreas em “Áreas e Sobreposição”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível encontrar as duas imagens. Tire uma fotografia em que ambas apareçam por inteiro ou defina as áreas em “Áreas e sobreposição”."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cele două imagini nu au fost găsite. Faceți o poză în care ambele imagini apar complet sau setați zonele imaginilor cu „Zone și suprapunere”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось найти две картинки. Сфотографируйте обе картинки целиком или задайте области в «Области и наложение»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dva obrázky sa nenašli. Odfoťte oba obrázky celé alebo nastavte oblasti v „Oblasti a prekrytie“."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att hitta de två bilderna. Ta ett foto där båda bilderna syns helt, eller ange bildområdena med ”Justera områden och överlägg”."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบภาพทั้งสอง โปรดถ่ายให้เห็นภาพทั้งสองครบถ้วน หรือกำหนดขอบเขตภาพด้วย \"ปรับขอบเขตและการซ้อนภาพ\""
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki resim bulunamadı. İki resmin de tamamen göründüğü bir fotoğraf çekin veya resim alanlarını “Alanları ve Hizalamayı Ayarla” ile belirleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося знайти дві картинки. Сфотографуйте обидві картинки повністю або задайте області в «Області й накладання»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy hai hình. Hãy chụp ảnh có đủ cả hai hình hoặc chỉ định vùng hình bằng \"Chỉnh vùng và chồng hình\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能找到两张图。请拍摄能完整显示两张图的照片，或通过“调整范围与叠加”指定图片范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到兩張圖。請拍攝能完整顯示兩張圖的照片，或透過「調整範圍與疊合」指定圖片範圍。"
          }
        }
      }
    },
    "2 つの絵を重ねる": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Superposar les imatges"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Překrýt obrázky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læg billederne oven på hinanden"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder überlagern"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επικάλυψη εικόνων"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overlay the Pictures"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Superponer imágenes"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseta kuvat päällekkäin"
          }
        },
