    "ずれている所や間違いがちらついて見えます": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els punts desalineats i les diferències parpellejaran"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posunutá místa a rozdíly budou blikat"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forskudte steder og forskelle vil flimre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschobene Stellen und Unterschiede flackern"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα μετατοπισμένα σημεία και οι διαφορές θα τρεμοπαίζουν"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Misaligned spots and differences will flicker"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las zonas desalineadas y las diferencias parpadearán"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirtyneet kohdat ja erot välkkyvät"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les décalages et les différences vont clignoter"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खिसके हुए हिस्से और अंतर टिमटिमाते दिखेंगे"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomaknuta mjesta i razlike će treperiti"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elcsúszott részek és az eltérések villódzni fognak"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagian yang meleset dan perbedaan akan berkedip"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I punti disallineati e le differenze lampeggeranno"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어긋난 곳과 틀린 부분이 깜빡여 보입니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahagian yang tersasar dan perbezaan akan berkelip"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forskjøvne steder og forskjeller vil flimre"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschoven plekken en verschillen gaan knipperen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesunięte miejsca i różnice będą migać"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontos desalinhados e diferenças vão piscar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pontos desalinhados e as diferenças vão piscar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonele nealiniate și diferențele vor pâlpâi"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смещённые места и отличия будут мерцать"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Posunuté miesta a rozdiely budú blikať"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Felplacerade ställen och skillnader kommer att flimra"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จุดที่ไม่ตรงกันและจุดที่แตกต่างจะกะพริบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaymış yerler ve farklar titreşerek görünecek"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміщені місця та відмінності мерехтітимуть"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỗ lệch và điểm khác sẽ nhấp nháy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "错位之处和不同之处会闪烁"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錯位之處與不同之處會閃爍"
          }
        }
      }
    },
    "ぴったり重なった所は黒くなります。色が残る所が間違いの候補です": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les zones que coincideixen exactament es tornen negres. Les que continuen amb color poden ser diferències"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přesně shodná místa zčernají. Barevná místa jsou možné rozdíly"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Områder, der passer præcist, bliver sorte. Områder, der forbliver farvede, kan være forskelle"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exakt deckungsgleiche Stellen werden schwarz. Farbige Stellen sind mögliche Unterschiede"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα σημεία που ταιριάζουν ακριβώς γίνονται μαύρα. Τα έγχρωμα σημεία είναι πιθανές διαφορές"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Areas that match exactly turn black. Areas that stay colored may be differences"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las zonas que coinciden exactamente se vuelven negras. Las que siguen con color pueden ser diferencias"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täsmälleen yhteneväiset alueet muuttuvat mustiksi. Värillisinä pysyvät alueet voivat olla eroja"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les zones identiques deviennent noires. Les zones encore colorées sont des différences possibles"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिल्कुल मेल खाने वाले हिस्से काले हो जाते हैं। जो हिस्से रंगीन रहते हैं, वे अंतर हो सकते हैं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mjesta koja se točno podudaraju postaju crna. Obojena mjesta su moguće razlike"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A pontosan egyező részek feketék lesznek. A színes maradó részek lehetnek eltérések"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagian yang cocok persis menjadi hitam. Bagian yang tetap berwarna mungkin merupakan perbedaan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le aree che coincidono perfettamente diventano nere. Quelle che restano colorate possono essere differenze"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정확히 겹친 곳은 검게 됩니다. 색이 남은 곳이 틀린 부분 후보입니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kawasan yang sepadan tepat menjadi hitam. Kawasan yang kekal berwarna mungkin perbezaan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Områder som stemmer nøyaktig, blir svarte. Områder som forblir fargede, kan være forskjeller"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plekken die precies overeenkomen worden zwart. Plekken die gekleurd blijven, kunnen verschillen zijn"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Idealnie pasujące miejsca stają się czarne. Kolorowe miejsca to możliwe różnice"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As áreas que coincidem exatamente ficam pretas. As que continuam coloridas podem ser diferenças"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As áreas que coincidem exatamente ficam pretas. As que continuam coloridas podem ser diferenças"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonele care coincid perfect devin negre. Zonele care rămân colorate pot fi diferențe"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точно совпадающие места станут чёрными. Цветные места — возможные отличия"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Presne zhodné miesta sčernejú. Farebné miesta sú možné rozdiely"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Områden som stämmer exakt blir svarta. Områden som förblir färgade kan vara skillnader"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่วนที่ซ้อนกันพอดีจะเป็นสีดำ ส่วนที่ยังมีสีอาจเป็นจุดที่แตกต่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam örtüşen alanlar siyah olur. Renkli kalan alanlar fark olabilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місця, що точно збігаються, стають чорними. Кольорові місця — можливі відмінності"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỗ trùng khớp hoàn toàn sẽ chuyển đen. Chỗ còn màu có thể là điểm khác"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完全重合的部分会变黑。仍有颜色的部分可能是不同之处"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完全重疊的部分會變黑。仍有顏色的部分可能是不同之處"
          }
        }
      }
    },
