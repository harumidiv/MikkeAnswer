          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移 ● 使其对齐左图的四个角"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移 ● 以對齊左圖的四個角落"
          }
        }
      }
    },
    "この端末では Metal を利用できません。": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal no està disponible en aquest dispositiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal není na tomto zařízení k dispozici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal er ikke tilgængelig på denne enhed."
          }
        },
        "de": {
