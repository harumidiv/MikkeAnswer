    "結果画面の「保存」で、判定した間違い探しをこの端末に保存できます": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca «Desa» a la pantalla de resultats per conservar els jocs resolts en aquest dispositiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na „Uložit“ na obrazovce výsledků si vyřešené hádanky uložíte do tohoto zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på “Gem” på resultatskærmen for at beholde løste opgaver på denne enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe im Ergebnis auf „Sichern“, um gelöste Rätsel auf diesem Gerät zu speichern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αγγίξτε «Αποθήκευση» στην οθόνη αποτελεσμάτων για να κρατήσετε τους λυμένους γρίφους σε αυτήν τη συσκευή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap “Save” on the results screen to keep solved puzzles on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca «Guardar» en la pantalla de resultados para conservar los juegos resueltos en este dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna ratkaistut tehtävät tähän laitteeseen napauttamalla tulosnäytössä ”Tallenna”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez « Enregistrer » sur l’écran des résultats pour conserver les jeux résolus sur cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हल की गई पहेलियों को इस डिवाइस पर रखने के लिए परिणाम स्क्रीन पर \"सहेजें\" पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite „Spremi” na zaslonu rezultata kako biste riješene zagonetke spremili na ovaj uređaj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eredményképernyőn a „Mentés” gombra koppintva a megoldott rejtvényeket erre az eszközre mentheti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk “Simpan” di layar hasil untuk menyimpan teka-teki yang sudah diperiksa di perangkat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca «Salva» nella schermata dei risultati per conservare i giochi risolti su questo dispositivo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과 화면에서 '저장'을 탭하면 판정한 틀린 그림 찾기를 이 기기에 저장할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik “Simpan” pada skrin keputusan untuk menyimpan teka-teki yang telah diperiksa pada peranti ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på «Lagre» på resultatskjermen for å beholde løste oppgaver på denne enheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op 'Bewaar' in het resultatenscherm om opgeloste puzzels op dit apparaat te bewaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij „Zachowaj” na ekranie wyników, aby zachować rozwiązane łamigłówki na tym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em “Salvar” na tela de resultados para manter os jogos resolvidos neste dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em “Guardar” no ecrã de resultados para manter os jogos resolvidos neste dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apăsați „Salvează” pe ecranul de rezultate pentru a păstra jocurile rezolvate pe acest dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Сохранить» на экране результата, чтобы сохранить решённые головоломки на этом устройстве."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na „Uložiť“ na obrazovke výsledkov si vyriešené hádanky uložíte do tohto zariadenia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på ”Spara” på resultatskärmen för att behålla lösta pussel på den här enheten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ \"บันทึก\" ในหน้าผลลัพธ์เพื่อเก็บภาพจับผิดที่ตรวจแล้วไว้ในอุปกรณ์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çözülen bulmacaları bu aygıtta saklamak için sonuç ekranında “Kaydet”e dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться «Зберегти» на екрані результату, щоб зберегти розв’язані головоломки на цьому пристрої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào “Lưu” trên màn hình kết quả để giữ các câu đố đã giải trên thiết bị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在结果画面点击“保存”，即可将已判定的找不同保存到本设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在結果畫面點一下「儲存」，即可將已判定的找不同儲存到此裝置。"
          }
        }
      }
    },
