    "間違いが見つかりませんでした。感度を上げてみてください。": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’han trobat diferències. Prova d’augmentar la sensibilitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádné rozdíly nenalezeny. Zkuste zvýšit citlivost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke fundet nogen forskelle. Prøv at øge følsomheden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Unterschiede gefunden. Erhöhe die Empfindlichkeit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκαν διαφορές. Δοκιμάστε να αυξήσετε την ευαισθησία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No differences found. Try increasing the sensitivity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han encontrado diferencias. Prueba a aumentar la sensibilidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Eroja ei löytynyt. Kokeile suurentaa herkkyyttä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune différence trouvée. Essayez d’augmenter la sensibilité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई अंतर नहीं मिला। संवेदनशीलता बढ़ाकर देखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nisu pronađene razlike. Pokušajte povećati osjetljivost."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem található eltérés. Próbálja növelni az érzékenységet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada perbedaan yang ditemukan. Coba naikkan sensitivitas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna differenza trovata. Prova ad aumentare la sensibilità."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "틀린 부분을 찾지 못했습니다. 민감도를 높여 보십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada perbezaan ditemui. Cuba tingkatkan kepekaan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ingen forskjeller. Prøv å øke følsomheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen verschillen gevonden. Probeer de gevoeligheid te verhogen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono różnic. Spróbuj zwiększyć czułość."
          }
        },
        "pt-BR": {
          "stringUnit": {
