    "画像を読み込めませんでした。": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha pogut carregar la imatge."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrázek nelze načíst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billedet kunne ikke indlæses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild konnte nicht geladen werden."
          }
        },
