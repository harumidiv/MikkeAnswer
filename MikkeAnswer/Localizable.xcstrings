            "value": "Impossible d’allouer la mémoire pour le traitement de l’image."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इमेज प्रोसेसिंग के लिए मेमोरी आवंटित नहीं की जा सकी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
