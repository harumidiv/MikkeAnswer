    "右の絵をドラッグ・ピンチ・回転して、左の絵にぴったり重ねてください": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrossega, pinça i gira la imatge dreta per alinear-la exactament amb l’esquerra"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tažením, sevřením a otáčením pravého obrázku ho přesně překryjte s levým"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk, knib og drej det højre billede, så det passer præcist over det venstre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschiebe, zoome und drehe das rechte Bild, bis es genau auf dem linken liegt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε, τσιμπήστε και περιστρέψτε τη δεξιά εικόνα ώστε να ταιριάξει ακριβώς με την αριστερή"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag, pinch, and rotate the right picture to line it up exactly with the left one"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra, pellizca y gira la imagen derecha para alinearla exactamente con la izquierda"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä, nipistä ja kierrä oikeaa kuvaa, kunnes se on täsmälleen vasemman kuvan päällä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser, pincez et faites pivoter l’image de droite pour l’aligner exactement sur celle de gauche"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दाएँ चित्र को ड्रैग, पिंच और घुमाकर बाएँ चित्र पर ठीक से मिलाएँ"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povlačenjem, stiskanjem i rotiranjem desne slike točno je preklopite s lijevom"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzza, csíptesse és forgassa a jobb oldali képet, hogy pontosan fedje a bal oldalit"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret, cubit, dan putar gambar kanan agar pas dengan gambar kiri"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina, pizzica e ruota l’immagine destra per allinearla esattamente a quella sinistra"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 그림을 드래그, 핀치, 회전하여 왼쪽 그림에 정확히 겹치십시오"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret, cubit dan putar gambar kanan supaya sepadan tepat dengan gambar kiri"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra, knip og roter det høyre bildet slik at det ligger nøyaktig over det venstre"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep, knijp en draai de rechterafbeelding zodat die precies over de linker valt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągaj, zsuwaj palce i obracaj prawy obrazek, aby dokładnie nałożyć go na lewy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste, faça o gesto de pinça e gire a imagem direita para alinhá-la exatamente com a esquerda"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste, belisque e rode a imagem direita para a alinhar exatamente com a esquerda"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trageți, ciupiți și rotiți imaginea dreaptă pentru a o alinia exact cu cea stângă"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте, масштабируйте и поворачивайте правую картинку, чтобы точно совместить её с левой"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahnutím, stiahnutím prstov a otáčaním pravého obrázka ho presne prekryte s ľavým"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
