    "●をドラッグして、右の絵の四隅に合わせてください": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrossega els ● fins a les quatre cantonades de la imatge dreta"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetáhněte ● do čtyř rohů pravého obrázku"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk ●-håndtagene til de fire hjørner af det højre billede"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe die ● auf die vier Ecken des rechten Bildes"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε τα ● στις τέσσερις γωνίες της δεξιάς εικόνας"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the ● handles to the four corners of the right picture"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra los ● a las cuatro esquinas de la imagen derecha"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä ●-kahvat oikean kuvan neljään kulmaan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les ● sur les quatre coins de l’image de droite"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "● को दाएँ चित्र के चारों कोनों पर ड्रैग करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povucite ● na četiri kuta desne slike"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzza a ● fogantyúkat a jobb oldali kép négy sarkához"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret ● ke empat sudut gambar kanan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina i ● sui quattro angoli dell’immagine destra"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "●을 드래그하여 오른쪽 그림의 네 모서리에 맞추십시오"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret ● ke empat penjuru gambar kanan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra ●-håndtakene til de fire hjørnene av det høyre bildet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep de ● naar de vier hoeken van de rechterafbeelding"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij ● do czterech rogów prawego obrazka"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste os ● até os quatro cantos da imagem direita"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste os ● para os quatro cantos da imagem direita"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trageți mânerele ● în cele patru colțuri ale imaginii drepte"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите ● к четырём углам правой картинки"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahnite ● do štyroch rohov pravého obrázka"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra ●-handtagen till den högra bildens fyra hörn"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลาก ● ไปที่มุมทั้งสี่ของภาพขวา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "● tutamaçlarını sağ resmin dört köşesine sürükleyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть ● до чотирьох кутів правої картинки"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo các ● đến bốn góc của hình phải"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移 ● 使其对齐右图的四个角"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移 ● 以對齊右圖的四個角落"
          }
        }
      }
    },
