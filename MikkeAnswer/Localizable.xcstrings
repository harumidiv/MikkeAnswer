    "画像処理用のメモリを確保できませんでした。": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha pogut reservar memòria per processar la imatge."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nelze přidělit paměť pro zpracování obrazu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kunne ikke tildeles hukommelse til billedbehandlingen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Bildverarbeitung konnte kein Speicher reserviert werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η δέσμευση μνήμης για την επεξεργασία εικόνας."
